# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.

# --- Staff sign-in (verifies a login email against the school staff API) ---
# Base URL of the staff directory API (no trailing slash).
STAFF_API_BASE=https://your-staff-api.example.com
# Bearer token with staff.read scope. Server-side only; never sent to the browser.
STAFF_API_TOKEN=CHANGE-ME

# Shared password every staff member enters alongside their email.
STAFF_PASSWORD=CHANGE-ME

# --- Session cookie signing ---
# Long random string used to sign the session token (HMAC-SHA256).
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=CHANGE-ME

# How many hours a sign-in lasts (optional, default 12).
SESSION_HOURS=12

# --- Student roster sync (optional) ---
# An API key with the students.read ability, from the same school system as
# STAFF_API_BASE. Lets the Class Tracker's "Sync students" button compare its
# class lists with the school's Year 1-6 classes. Falls back to STAFF_API_TOKEN
# if that key happens to carry the ability. Without it, sync says so and the
# tracker keeps using its own lists.
STUDENTS_API_TOKEN=

# --- Class Tracker shared storage (optional) ---
# A Redis-compatible KV (Vercel KV / Upstash) so the reading-assessment tracker
# is shared across the live site, phonics.test, and every device. Connect a KV
# store to the Vercel project (Storage tab) to get these automatically, then run
# `vercel env pull .env.local` so local dev shares the same data. If unset, the
# tracker falls back to per-browser storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=
